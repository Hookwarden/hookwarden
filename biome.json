{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.cjs",
      "**/*.mjs",
      "**/*.json",
      "!e2e/fixtures",
      "!**/test/fixtures",
      "!packages/canonical-json/test/cyberphone-vectors",
      "!**/tests/fixtures",
      "!assets/brand/demo-fixtures",
      "!**/*.fix-positive.expected.*",
      "!**/fp-measurement-*-result.json",
      "!**/.astro"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 50 }
        },
        "noStaticOnlyClass": "error",
        "noUselessTypeConstraint": "error",
        "noUselessFragments": "error",
        "useFlatMap": "error",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnreachable": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useImportType": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "conventions": [
              {
                "selector": { "kind": "objectLiteralProperty" },
                "match": ".+"
              },
              {
                "selector": { "kind": "typeProperty" },
                "match": ".+"
              }
            ]
          }
        },
        "useSelfClosingElements": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": { "allow": ["warn", "error"] }
        },
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.test.ts", "e2e/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useNamingConvention": "off"
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
