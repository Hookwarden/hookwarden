{
  "name": "@hookwarden/rules",
  "version": "0.8.0-beta.2",
  "description": "hookwarden detection rule pack — 230 webhook signature-verification rules across 21 providers (Stripe, GitHub, Shopify, Slack, Twilio, Square + 15 more, including Standard Webhooks conformant). Every rule cited (CWE / RFC / Svix / Stripe spec). Test-path-aware severity. Consumed by the @hookwarden/engine analyzer.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fix": {
      "import": "./dist/fix/index.js",
      "types": "./dist/fix/index.d.ts"
    }
  },
  "files": [
    "dist",
    "rules",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hookwarden/hookwarden.git",
    "directory": "packages/rules"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --build",
    "compliance-coverage": "node scripts/check-compliance-coverage.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "node scripts/sync-version.mjs && node scripts/sync-bundle.mjs",
    "prepack": "node scripts/sync-version.mjs && node scripts/sync-bundle.mjs"
  },
  "dependencies": {
    "@hookwarden/engine": "workspace:*",
    "@hookwarden/fix": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "js-yaml": "^4.1.1",
    "@types/js-yaml": "^4.0.9"
  }
}
