{
  "name": "@hookwarden/fix",
  "version": "0.7.4",
  "description": "hookwarden auto-remediation — mechanical AST rewrites for the safe-codegen rule subset (timing-unsafe → constant-time comparison, raw-body misuse). Atomic staging, re-scan before replace, never edits inside strings or comments. Powers `hookwarden fix`.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./staging": {
      "import": "./dist/staging.js",
      "types": "./dist/staging.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hookwarden/hookwarden.git",
    "directory": "packages/fix"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hookwarden/engine": "workspace:*",
    "@babel/generator": "^7.29.7",
    "@babel/traverse": "^7.29.7"
  },
  "devDependencies": {
    "@babel/types": "^7.29.7"
  }
}
