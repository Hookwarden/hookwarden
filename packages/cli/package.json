{
  "name": "hookwarden",
  "version": "0.8.1",
  "description": "Webhook security audit CLI — finds signature-verification bugs in JavaScript, TypeScript, Python, and PHP codebases. Local, deterministic, zero-network. 230 rules across 21 providers (Stripe, GitHub, Shopify, Slack, Twilio, Square, Sentry, Zendesk, DocuSign, PagerDuty, Notion + Standard Webhooks conformant) — every rule cited (CWE / RFC / Svix). 3-state verdict (verified / not-verified / manual-review), <5% false-positive rate, JSON / SARIF 2.1.0 output for CI and GitHub Code Scanning.",
  "keywords": [
    "webhook",
    "webhooks",
    "webhook-security",
    "security",
    "audit",
    "static-analysis",
    "sast",
    "sarif",
    "code-scanning",
    "stripe",
    "github",
    "shopify",
    "slack",
    "twilio",
    "square",
    "php",
    "laravel",
    "symfony",
    "hmac",
    "signature-verification",
    "cli"
  ],
  "homepage": "https://hookwarden.dev",
  "bugs": {
    "url": "https://github.com/Hookwarden/hookwarden/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hookwarden": "./bin/cli.cjs"
  },
  "files": [
    "dist",
    "bin",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hookwarden/hookwarden.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "prepare": "node scripts/sync-wasm.mjs && node scripts/sync-version.mjs",
    "prepack": "node scripts/sync-wasm.mjs && node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@hookwarden/engine": "workspace:*",
    "@hookwarden/fix": "workspace:*",
    "@hookwarden/rules": "workspace:*",
    "ajv": "^8.17.1",
    "citty": "^0.2.2",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.1",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.16",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/tar": "^7.0.87",
    "@types/update-notifier": "^6.0.8",
    "tar": "7.5.16",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "0.26.9"
  }
}
