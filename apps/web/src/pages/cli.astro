---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>hookwarden CLI reference</title>
  </head>
  <body class="min-h-screen bg-bg text-text">
    <header class="mx-auto max-w-4xl px-6 py-12">
      <h1 class="text-4xl font-bold tracking-tight">CLI reference</h1>
      <p class="mt-2 text-text/80">
        <a href="/" class="text-accent underline">← home</a>
      </p>
    </header>

    <main class="mx-auto max-w-4xl px-6 pb-24 space-y-12">
      <section>
        <h2 class="text-2xl font-semibold">
          <code class="font-mono text-accent">hookwarden scan [path]</code>
        </h2>
        <p class="mt-3 text-text/80">
          Read-only audit. Scans JS/TS + Python + PHP webhook handlers for
          signature-verification bugs. Exit codes:
          <code class="font-mono">0</code> clean,
          <code class="font-mono">1</code> findings at threshold,
          <code class="font-mono">2</code> engine error,
          <code class="font-mono">3</code> config error.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">
          <code class="font-mono text-accent">hookwarden fix [path]</code>
        </h2>
        <p class="mt-3 text-text/80">
          Apply mechanical fixes for <code class="font-mono">safety: safe</code>
          findings. Dry-run by default; <code class="font-mono">--write</code>
          opt-in writes via the atomic-staging path.
        </p>
        <h3 class="mt-6 text-lg font-semibold">Flags</h3>
        <dl class="mt-3 space-y-3 font-mono text-sm">
          <div>
            <dt><code>--write</code></dt>
            <dd class="text-text/80 ml-4">
              Write fixes to disk via atomic staging. Default: dry-run.
            </dd>
          </div>
          <div>
            <dt><code>--mode safe | all | manual-only-explain</code></dt>
            <dd class="text-text/80 ml-4">
              Default <code>safe</code>. <code>all</code> requires
              <code>--accept-unsafe</code> in non-TTY.
            </dd>
          </div>
          <div>
            <dt><code>--only IDS</code></dt>
            <dd class="text-text/80 ml-4">
              Comma-separated rule IDs to filter. Used for gradual rollout and
              conflict-resolution fallback.
            </dd>
          </div>
          <div>
            <dt><code>--format text | json</code></dt>
            <dd class="text-text/80 ml-4">
              <code>--format json</code> forces dry-run; emits the v1.0 schema
              at <code>hookwarden.dev/schemas/fix-output.v1.json</code>.
            </dd>
          </div>
        </dl>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">Safety levels</h2>
        <p class="mt-3 text-text/80">
          Every rule declares its fixability in the rule pack YAML. Three
          values are recognized:
        </p>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-text/80">
          <li>
            <code class="font-mono">safety: safe</code> — mechanical rewrite
            is provably semantic-preserving + strengthens security. 10 rules in
            v0.5 (timing-unsafe-comparison + raw-body-misuse families).
          </li>
          <li>
            <code class="font-mono">safety: unsafe</code> — mechanical rewrite
            exists but requires user review; refuses in non-TTY without
            <code class="font-mono">--accept-unsafe</code>.
          </li>
          <li>
            <code class="font-mono">safety: manual-only</code> — prose only via
            <code class="font-mono">--mode manual-only-explain</code>. 35 rules
            ship as manual-only in v0.5.
          </li>
        </ul>
      </section>
    </main>
  </body>
</html>
