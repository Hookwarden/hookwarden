{
  "name": "hookwarden-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "purity": "depcruise --config .dependency-cruiser.cjs --validate packages",
    "inspect-bundle": "pnpm --filter hookwarden exec tsx scripts/inspect-bundle.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "^22",
    "axios": "1.7.9",
    "tsx": "4.21.0",
    "typescript": "5.6.2",
    "vitest": "4.1.5"
  }
}
