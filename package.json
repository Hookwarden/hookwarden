{
  "name": "hookwarden-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build && pnpm --filter @hookwarden/mcp build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "purity": "node -e \"for (const e of ['js','js.map','d.ts','d.ts.map']) require('fs').rmSync('packages/engine/dist/__purity-fixture.'+e,{force:true})\" && depcruise --config .dependency-cruiser.cjs packages",
    "preflight": "pnpm lint && pnpm purity && pnpm build && pnpm test",
    "inspect-bundle": "pnpm --filter hookwarden exec tsx scripts/inspect-bundle.ts",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "^22",
    "axios": "1.20.0",
    "dependency-cruiser": "18.5.0",
    "picocolors": "1.1.1",
    "simple-git-hooks": "2.14.0",
    "tinyglobby": "^0.2.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm preflight"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.24.0",
      "fast-uri": "^3.1.2"
    }
  }
}
