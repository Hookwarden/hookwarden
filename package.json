{
  "name": "hookwarden-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "purity": "depcruise --config .dependency-cruiser.cjs packages",
    "preflight": "pnpm lint && pnpm purity && pnpm build && pnpm test",
    "inspect-bundle": "pnpm --filter hookwarden exec tsx scripts/inspect-bundle.ts",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "2.31.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "^25",
    "axios": "1.16.1",
    "dependency-cruiser": "17.4.2",
    "picocolors": "1.1.1",
    "simple-git-hooks": "2.13.1",
    "tinyglobby": "^0.2.16",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm preflight"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.24.0",
      "fast-uri": "^3.1.2"
    }
  }
}
