node_modules/
dist/
*.tsbuildinfo
.DS_Store
coverage/
.changeset/.changes/
e2e/fixtures/perf/generated/
# Bundled WASM artifact — copied at install/pack time by packages/cli/scripts/sync-wasm.mjs.
packages/cli/wasm/
# Version constants — generated at install/pack/CI time from each package's
# package.json#version by scripts/sync-version.mjs (prevents Bun --compile reading
# /$bunfs/package.json). Same pattern as packages/cli/wasm/ above.
packages/cli/src/version.ts
packages/rules/src/version.ts
# Bundled rule documents — generated by packages/rules/scripts/sync-bundle.mjs from
# packages/rules/rules/**/*.yaml. Bakes parsed rule content into the binary so Bun
# --compile output is self-contained (no fs reads, no YAML parsing at runtime).
packages/rules/src/bundled-rules.ts

# Python build/test artifacts (PyPI shim — python-packages/hookwarden)
__pycache__/
*.py[co]
*.egg-info/
.pytest_cache/
.venv/
build/
